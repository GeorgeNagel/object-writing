{
  "permissions": {
    "allow": [
      "Bash(mv tasks/)",
      "Bash(mv /Users/george/code/ai-object-writing/tasks/)",
      "Edit(tasks/*/*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(web/src/*)",
            "command": "cd /Users/george/code/ai-object-writing/web && npm run lint && npm run test",
            "timeout": 60,
            "statusMessage": "Running lint and tests..."
          }
        ]
      }
    ]
  }
}
